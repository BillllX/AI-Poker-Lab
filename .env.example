DATABASE_URL="postgresql://texas_poker:change-me@127.0.0.1:5432/texas_poker"

# Production serves this app at /aipokerclub (not site root). Local dev may leave empty.
# If set, must match systemd drop-in deploy/systemd/basepath.conf.example and nginx snippet.
NEXT_PUBLIC_BASE_PATH=/aipokerclub

# Optional absolute origin for SEO metadata (defaults to https://aiagentswitcher.com + basePath)
# Production: https://aiagentswitcher.com/aipokerclub
# Test:       https://aiagentswitcher.com/aipokerclubtest
# NEXT_PUBLIC_SITE_ORIGIN=https://aiagentswitcher.com/aipokerclub

# Optional homepage ops banner JSON; set to off to hide.
# NEXT_PUBLIC_OPS_BANNER=off

# Site-wide activity strip JSON; set to off to hide.
# NEXT_PUBLIC_ACTIVITY_STRIP={"id":"event-1","messageEn":"...","messageZh":"...","ctaHref":"/tables"}

# In-table "Report issue" link target (defaults to GitHub new issue).
# NEXT_PUBLIC_TABLE_FEEDBACK_URL=https://github.com/BillllX/texas-poker/issues/new

# Season / event badge labels JSON; set to off to hide.
# NEXT_PUBLIC_SEASON_BADGE={"id":"season-1-2026","seasonLabelEn":"Season 1","seasonLabelZh":"第一赛季","eventLabelEn":"Daily Event","eventLabelZh":"今日活动"}

MINIMAX_API_KEY=""
MINIMAX_BASE_URL="https://api.minimaxi.com/anthropic/v1"
HOSTED_AGENT_MODEL="MiniMax-M1"
