generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                   String                     @id
  name                 String                     @unique
  email                String?                    @unique
  passwordHash         String?
  pointsBalance        Int                        @default(10000)
  frozenPoints         Int                        @default(0)
  tokenHash            String
  encryptedUserToken   String?
  createdAt            DateTime                   @default(now())
  ledgerEntries        PointsLedger[]
  leaderboardSnapshots LeaderboardDailySnapshot[]
  agentQualifications  AgentQualification[]
  agentResults         AgentResult[]
  agentProfileContents AgentProfileContent[]
  agentPrivateSettings AgentPrivateSettings?
  dailyBadges           UserDailyBadge[]

  @@index([pointsBalance(sort: Desc), createdAt])
  @@map("users")
}

model UserDailyBadge {
  id       String   @id
  userId   String
  dayKey   String
  badge    String
  earnedAt DateTime @default(now())
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dayKey, badge])
  @@index([userId, dayKey])
  @@map("user_daily_badges")
}

model AgentQualification {
  id              String    @id
  agentId         String
  ownerUserId     String
  modelName       String
  protocolVersion String
  passedAt        DateTime  @default(now())
  expiresAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  user            User      @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)

  @@unique([agentId, ownerUserId, modelName, protocolVersion])
  @@index([ownerUserId])
  @@index([ownerUserId, passedAt(sort: Desc)])
  @@map("agent_qualifications")
}

model PointsLedger {
  id            String   @id
  userId        String
  type          String
  amount        Int
  balanceAfter  Int
  frozenAfter   Int
  gameSessionId String?
  agentId       String?
  note          String?
  dayKey        String
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, dayKey])
  @@index([dayKey])
  @@index([dayKey, type, userId])
  @@map("points_ledger")
}

model LeaderboardDailySnapshot {
  id            String   @id
  dayKey        String
  userId        String
  rank          Int
  pointsBalance Int
  userCreatedAt DateTime
  capturedAt    DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([dayKey, userId])
  @@index([dayKey, rank])
  @@index([userId, dayKey])
  @@map("leaderboard_daily_snapshots")
}

model HumanHandSummary {
  id             String   @id
  tableId        String
  tableName      String?
  handId         Int
  startedAt      DateTime
  completedAt    DateTime @default(now())
  dealerIndex    Int
  smallBlind     Int
  bigBlind       Int
  communityCards Json
  actions        Json
  logs           Json
  players        Json
  winners        Json
  totalAwarded   Int
  createdAt      DateTime @default(now())

  @@unique([tableId, handId])
  @@index([tableId, completedAt(sort: Desc)])
  @@map("human_hand_summaries")
}

model AgentResult {
  id            String   @id
  agentId       String
  ownerUserId   String
  modelName     String?
  tableId       String
  gameSessionId String?
  buyIn         Int
  finalStack    Int
  profit        Int
  handsPlayed   Int
  handsWon      Int
  settledReason String
  settledAt     DateTime @default(now())
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)

  @@index([ownerUserId, settledAt])
  @@index([ownerUserId, profit(sort: Desc), settledAt(sort: Desc)])
  @@index([agentId, settledAt])
  @@index([modelName, settledAt])
  @@map("agent_results")
}

model AgentProfileContent {
  id          String   @id
  agentId     String
  ownerUserId String
  html        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)

  @@unique([agentId, ownerUserId])
  @@index([ownerUserId])
  @@map("agent_profile_contents")
}

model AgentPrivateSettings {
  id          String   @id
  ownerUserId String   @unique
  agentPrompt String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)

  @@map("agent_private_settings")
}
