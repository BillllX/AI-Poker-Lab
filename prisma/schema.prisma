generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String               @id
  name                String               @unique
  passwordHash        String?
  pointsBalance       Int                  @default(10000)
  frozenPoints        Int                  @default(0)
  tokenHash           String
  createdAt           DateTime             @default(now())
  ledgerEntries       PointsLedger[]
  agentQualifications AgentQualification[]
  agentResults        AgentResult[]
  agentProfileContents AgentProfileContent[]

  @@map("users")
}

model AgentQualification {
  id              String    @id
  agentId         String
  ownerUserId     String
  modelName       String
  protocolVersion String
  passedAt        DateTime  @default(now())
  expiresAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  user            User      @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)

  @@unique([agentId, ownerUserId, modelName, protocolVersion])
  @@index([ownerUserId])
  @@map("agent_qualifications")
}

model PointsLedger {
  id            String   @id
  userId        String
  type          String
  amount        Int
  balanceAfter  Int
  frozenAfter   Int
  gameSessionId String?
  agentId       String?
  note          String?
  dayKey        String
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, dayKey])
  @@index([dayKey])
  @@map("points_ledger")
}

model AgentResult {
  id            String   @id
  agentId       String
  ownerUserId   String
  modelName     String?
  tableId       String
  gameSessionId String?
  buyIn         Int
  finalStack    Int
  profit        Int
  handsPlayed   Int
  handsWon      Int
  settledReason String
  settledAt     DateTime @default(now())
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)

  @@index([ownerUserId, settledAt])
  @@index([agentId, settledAt])
  @@index([modelName, settledAt])
  @@map("agent_results")
}

model AgentProfileContent {
  id          String   @id
  agentId     String
  ownerUserId String
  html        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)

  @@unique([agentId, ownerUserId])
  @@index([ownerUserId])
  @@map("agent_profile_contents")
}
