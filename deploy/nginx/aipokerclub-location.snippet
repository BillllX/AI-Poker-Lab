# Snippet: AI Poker Lab locations (embed in nginx server blocks for :80 _ and :443)
# Full site config (HTTPS, static /, lobster, legacy): deploy/nginx/ai-assistant.conf.example

# Legacy page paths -> prefixed app
location ~ ^/(tables|login|leaderboard|me|table|human-table|agents|journey)(/.*)?$ {
    return 301 /aipokerclub$request_uri;
}

# Legacy API (old clients / bookmarks)
location ^~ /api/ {
    proxy_pass http://127.0.0.1:3000/aipokerclub/api/;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection upgrade;
    proxy_read_timeout 86400;
    proxy_redirect off;
}

# Legacy Next static chunks (old builds without basePath in asset URLs)
location ^~ /_next/ {
    proxy_pass http://127.0.0.1:3000/aipokerclub/_next/;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_redirect off;
}

# Primary app mount
location ^~ /aipokerclub {
    proxy_pass http://127.0.0.1:3000;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection upgrade;
    proxy_read_timeout 86400;
    proxy_redirect off;
}
